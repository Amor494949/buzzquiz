{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzquiz",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
